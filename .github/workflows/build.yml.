name: Build
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'
      - run: unzip ThunderMace.zip
      - run: mvn -B package
        working-directory: ThunderMace
      - uses: actions/upload-artifact@v4
        with:
          name: ThunderMace-jar
          path: ThunderMace/target/ThunderMace-1.2.0.jar
